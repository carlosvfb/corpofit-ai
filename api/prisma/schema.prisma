// CorpoFit AI SaaS: dados de assinatura, cobrança, consumo de IA e administração (PostgreSQL).
//
// O que NÃO está aqui, de propósito: contas/senhas/passkeys e o histórico de treino. No openGym
// eles vivem em db.json e state-<uid>.json (um documento por perfil, sincronizado por revisão).
// Treinos, exercícios, sessões e registros de séries são partes desse documento; conversas da IA
// ficam no registro do Coach. Aqui o `User` é um espelho mínimo, chaveado pelo mesmo `uid`.
// Valores monetários sempre em centavos.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCode {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  REFUSED
  CANCELED
}

enum PaymentMethodType {
  CREDIT_CARD
  PIX_AUTOMATIC
  PIX
}

enum EventProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Espelho do perfil do openGym (mesmo id). Criado sob demanda.
model User {
  id                  String    @id
  email               String?
  name                String
  isAdmin             Boolean   @default(false)
  /// Concessão manual de Premium (admin). Sempre auditada em AdminAuditLog.
  manualPremium       Boolean   @default(false)
  manualPremiumUntil  DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  usage           UsageRecord[]
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
  payments        Payment[]
  auditLogs       AdminAuditLog[] @relation("AuditActor")
  /// A academia cuja orientação de IA o usuário escolheu usar no Coach (null = espaço pessoal). Validada a cada uso.
  aiTenantId      String?
  /// E-mail confirmado por um código enviado a ele. Mudou o e-mail, deixa de valer (compara-se com emailVerifiedFor).
  emailVerifiedAt DateTime?
  emailVerifiedFor String?
  memberships     Membership[]
  trainerProfile  TrainerProfile?
  trainerLinks    TrainerStudent[] @relation("TrainerSide")
  studentLinks    TrainerStudent[] @relation("StudentSide")
}

/// Limites e preços por plano (espelho de api/saas/plans.js, que é a fonte da verdade).
model Plan {
  code               PlanCode @id
  name               String
  priceCents         Int
  cycle              String   @default("MONTHLY")
  aiMessagesPerMonth Int
  features           Json
  active             Boolean  @default(true)

  subscriptions Subscription[]
}

/// Consumo de IA: uma linha por chamada ao provedor (ou tentativa com falha).
model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  kind         String   @default("coach")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  success      Boolean  @default(true)
  model        String?
  /// Academia cujo contexto de IA o usuário estava usando (null = espaço pessoal).
  tenantId     String?
  provider     String?
  /// Custo estimado em micro-dólares (tokens × preço por milhão de tokens de AI_PRICES); null se não há preço.
  costMicros   Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([createdAt])
}

model BillingCustomer {
  id              String   @id @default(cuid())
  userId          String   @unique
  asaasCustomerId String   @unique
  /// Somente os 4 últimos dígitos, para exibição. O documento completo não é guardado.
  documentLast4   String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planCode             PlanCode
  status               SubscriptionStatus @default(PENDING)
  paymentMethod        PaymentMethodType
  asaasSubscriptionId  String?            @unique
  asaasAuthorizationId String?            @unique
  asaasCheckoutId      String?
  /// Dados para retomar o pagamento: { url } (checkout) ou { payload, image, expiresAt } (Pix).
  checkoutData         Json?
  /// Fim do período já pago. O Premium vale até aqui após o cancelamento.
  currentPeriodEnd     DateTime?
  /// Tolerância para cobrança vencida.
  graceUntil           DateTime?
  cancelRequestedAt    DateTime?
  canceledAt           DateTime?
  idempotencyKey       String             @unique
  /// Assinatura de ACADEMIA (paga pelo dono): o tenant e o código do plano da academia. Nas pessoais, ambos null.
  /// Nestas, `planCode` é só o valor técnico PREMIUM (chave estrangeira), não o plano da academia.
  tenantId             String?
  tenantPlan           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     Plan      @relation(fields: [planCode], references: [code])
  payments Payment[]

  @@index([userId, status])
  @@index([tenantId])
}

model Payment {
  id             String            @id @default(cuid())
  subscriptionId String
  userId         String
  asaasPaymentId String            @unique
  status         PaymentStatus     @default(PENDING)
  method         PaymentMethodType
  valueCents     Int
  dueDate        DateTime
  paidAt         DateTime?
  refundedAt     DateTime?
  invoiceUrl     String?
  pixPayload     String?
  pixExpiresAt   DateTime?
  /// Primeira cobrança da assinatura (a que libera o Premium).
  isInitial      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([subscriptionId])
  @@index([status, dueDate])
}

model PaymentEvent {
  id                   String                @id @default(cuid())
  externalEventId      String                @unique
  type                 String
  status               EventProcessingStatus @default(RECEIVED)
  asaasPaymentId       String?
  asaasSubscriptionId  String?
  asaasAuthorizationId String?
  receivedAt           DateTime              @default(now())
  processedAt          DateTime?
  error                String?

  @@index([status, receivedAt])
  @@index([asaasPaymentId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

/// Configurações editáveis pelo admin (ex.: pixAutomaticEnabled, graceDays).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Erros de integração (pagamentos/IA) para o painel admin. Só mensagens, nunca segredos.
model ErrorLog {
  id        String   @id @default(cuid())
  scope     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Modo Vercel (STORAGE=postgres): o "sistema de arquivos" do openGym (db.json, state-<uid>.json,
/// coach.json, audit.log…) vive aqui, uma linha por arquivo. `rev` é o controle otimista de
/// concorrência: uma gravação só vale se a revisão lida ainda é a atual (api/store/vfs.js).
model KvFile {
  path      String   @id
  content   String
  rev       Int      @default(1)
  updatedAt DateTime @default(now())
}

// ===== Academias (multi-tenant) =====
// Cada linha de Membership, TenantSettings e ActivityLog pertence a UM tenant (`tenantId`) e tem
// Row Level Security (migração 20261109130000_orgs): sem `app.tenant_id` (ou `app.user_id`, só para
// ler os próprios vínculos) a consulta não enxerga nada. A API também valida o papel em cada rota.

enum OrgRole {
  GYM_OWNER
  GYM_ADMIN
  GYM_MANAGER
  PERSONAL_TRAINER
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

model Tenant {
  id        String   @id @default(cuid())
  kind      String   @default("GYM")
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  settings    TenantSettings?
  activity    ActivityLog[]
}

/// Identidade visual, configuração de IA e recursos habilitados da academia (JSON validado na API).
model TenantSettings {
  tenantId  String   @id
  brand     Json     @default("{}")
  ai        Json     @default("{}")
  features  Json     @default("{}")
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Usuário × academia × papel. Uma pessoa pode ter vários vínculos sem duplicar a conta.
/// Só `ACTIVE` concede permissões; `INVITED` espera o aceite; `REMOVED` mantém o histórico.
model Membership {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  role        OrgRole
  status      MembershipStatus @default(ACTIVE)
  invitedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// Registro imutável de quem fez o quê numa academia, com o antes e o depois.
model ActivityLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ===== Personal trainers =====
// Um vínculo (TrainerStudent) liga um personal a um aluno, com ou sem academia (`tenantId`). Os dois lados
// veem o vínculo e as atribuições; ninguém mais (RLS por `app.user_id`, migração 20261109160000_trainers).
// Nesta fase o personal só ENVIA treinos que ele mesmo criou: não lê dados do aluno (isso exige o
// consentimento por categoria da fase 5).

enum TrainerLinkStatus {
  PENDING
  ACTIVE
  ENDED
}

enum LinkInitiator {
  TRAINER
  STUDENT
}

enum AssignmentStatus {
  ASSIGNED
  IMPORTED
  DECLINED
  ARCHIVED
}

model TrainerProfile {
  userId      String   @id
  displayName String
  bio         String   @default("")
  specialties String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrainerStudent {
  id          String            @id @default(cuid())
  trainerId   String
  studentId   String
  tenantId    String?
  status      TrainerLinkStatus @default(PENDING)
  initiatedBy LinkInitiator
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  endedAt     DateTime?

  trainer     User         @relation("TrainerSide", fields: [trainerId], references: [id], onDelete: Cascade)
  student     User         @relation("StudentSide", fields: [studentId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  sessions    TrainingSession[]
  notes       TrainerNote[]

  @@unique([trainerId, studentId])
  @@index([studentId])
}

/// Um treino enviado pelo personal ao aluno. `bundle` é o arquivo de plano do app (uma rotina); o
/// servidor só o guarda (limitado) e o aplicativo do aluno o valida ao importar.
model Assignment {
  id        String           @id @default(cuid())
  linkId    String
  trainerId String
  studentId String
  title     String
  note      String           @default("")
  bundle    Json
  /// ASSIGNMENT (treino novo) ou SUGGESTION (sugestão para uma rotina do aluno; exige permissão SUGGEST).
  kind      String           @default("ASSIGNMENT")
  target    String           @default("")
  status    AssignmentStatus @default(ASSIGNED)
  revision  Int              @default(1)
  history   Json             @default("[]")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  link     TrainerStudent      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  comments AssignmentComment[]

  @@index([studentId, createdAt])
  @@index([trainerId, createdAt])
}

model AssignmentComment {
  id           String   @id @default(cuid())
  assignmentId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
}

// ===== Privacidade e compartilhamento (fase 5) =====
// O aluno decide, por personal e por categoria, o que o personal pode ver (SEE) ou sugerir (SUGGEST). O
// servidor confere a permissão a CADA leitura (revogar vale na hora), registra o acesso para o aluno
// e guarda cada mudança de consentimento. CHANGE_DIRECTLY existe no tipo, mas ainda não pode ser
// concedido: alterar diretamente a conta do aluno não está implementado.

enum ShareCategory {
  WORKOUTS
  ROUTINES
  EXERCISE_HISTORY
  BODY_WEIGHT
  MEASUREMENTS
  PHOTOS
  NOTES
  ACTIVITY
  WELLBEING
}

enum ShareLevel {
  OFF
  SEE
  SUGGEST
  CHANGE_DIRECTLY
}

model SharingPermission {
  id        String        @id @default(cuid())
  studentId String
  trainerId String
  category  ShareCategory
  level     ShareLevel    @default(OFF)
  updatedAt DateTime      @updatedAt

  @@unique([studentId, trainerId, category])
  @@index([trainerId])
}

/// Histórico imutável: toda concessão, mudança e revogação, com quem fez e quando.
model ConsentRecord {
  id            String        @id @default(cuid())
  studentId     String
  trainerId     String
  category      ShareCategory
  previousLevel ShareLevel
  level         ShareLevel
  action        String
  actorUserId   String
  createdAt     DateTime      @default(now())

  @@index([studentId, createdAt])
}

/// Cada leitura de dados do aluno por um personal (para o aluno ver quem acessou o quê).
model AccessLog {
  id        String        @id @default(cuid())
  studentId String
  actorId   String
  category  ShareCategory
  createdAt DateTime      @default(now())

  @@index([studentId, createdAt])
}

// ===== Biblioteca comunitária (fase 7) =====
// Conteúdo que um usuário publica para todos (PUBLIC) ou só para a própria academia (GYM). O autor confirma
// que tem o direito de compartilhar; o servidor recusa dados pessoais óbvios e remove de dentro do treino
// qualquer referência a mídia, pesos ou links. Moderação: denúncias, ocultação e restauração (admin da
// plataforma, ou dono/admin da academia para o conteúdo dela). RLS em migração 20261109230000_community.

enum CommunityKind {
  ROUTINE
  PLAN
  TIP
  ARTICLE
}

enum CommunityVisibility {
  PUBLIC
  GYM
}

enum CommunityStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportReason {
  INAPPROPRIATE
  COPYRIGHT
  PERSONAL_DATA
  SPAM
  OTHER
}

model CommunityItem {
  id          String              @id @default(cuid())
  authorId    String
  tenantId    String?
  kind        CommunityKind
  visibility  CommunityVisibility @default(PUBLIC)
  status      CommunityStatus     @default(PUBLISHED)
  title       String
  description String              @default("")
  body        String              @default("")
  /// Rotina ou plano no formato do app, já higienizado (sem pesos, mídia ou links). Null em dicas e artigos.
  bundle      Json?
  /// Declaração do autor: o conteúdo é dele (ou ele tem o direito) e pode ser compartilhado.
  rightsConfirmed Boolean         @default(false)
  imports     Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  reports   CommunityReport[]
  favorites CommunityFavorite[]

  @@index([visibility, status, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([authorId])
}

model CommunityFavorite {
  userId    String
  itemId    String
  createdAt DateTime @default(now())

  item CommunityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
}

model CommunityReport {
  id         String       @id @default(cuid())
  itemId     String
  reporterId String
  reason     ReportReason
  note       String       @default("")
  /// OPEN até um moderador resolver; RESOLVED guarda quem e o que decidiu.
  status     String       @default("OPEN")
  decision   String?
  resolvedBy String?
  createdAt  DateTime     @default(now())

  item CommunityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, reporterId])
  @@index([status, createdAt])
}

// ===== Verificação de e-mail, convites a quem ainda não tem conta e notificações =====

/// Código de 6 dígitos (guardado só como hash) enviado ao e-mail da conta; vale 15 minutos e 5 tentativas.
model EmailVerification {
  userId    String   @id
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
}

/// Convite a um e-mail que ainda não tem conta. Só vira um convite de verdade (Membership INVITED) quando
/// alguém com esse e-mail CONFIRMADO entra; antes disso nada é concedido.
model PendingInvite {
  id          String    @id @default(cuid())
  email       String
  tenantId    String
  role        OrgRole
  invitedById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@unique([email, tenantId])
  @@index([tenantId])
}

/// Aviso dentro do app. `dedupeKey` evita avisar duas vezes o mesmo evento.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String    @default("")
  link      String    @default("")
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

// ===== Agenda e acompanhamento do personal =====

enum SessionStatus {
  PLANNED
  CONFIRMED
  DONE
  MISSED
  CANCELLED
}

/// Um treino marcado entre personal e aluno: dia e horário exatos (UTC; o app mostra no fuso de quem olha).
/// O personal marca e remarca; o aluno confirma ou recusa; depois do horário o personal registra se foi feito.
model TrainingSession {
  id           String        @id @default(cuid())
  linkId       String
  trainerId    String
  studentId    String
  /// Treino (Assignment) previsto para esta sessão, se houver.
  assignmentId String?
  title        String
  startsAt     DateTime
  durationMin  Int           @default(60)
  place        String        @default("")
  note         String        @default("")
  status       SessionStatus @default(PLANNED)
  /// Quem cancelou ('TRAINER' ou 'STUDENT') e por quê.
  cancelledBy  String?
  reason       String        @default("")
  /// Sessões criadas juntas ("repetir toda semana") compartilham este id.
  seriesId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  link TrainerStudent @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([trainerId, startsAt])
  @@index([studentId, startsAt])
}

/// Anotações PRIVADAS do personal sobre um aluno. O aluno nunca as vê.
model TrainerNote {
  id        String   @id @default(cuid())
  linkId    String
  trainerId String
  body      String
  createdAt DateTime @default(now())

  link TrainerStudent @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
}
